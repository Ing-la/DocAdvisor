# DocAdvisor 配置文件模板
# 复制此文件为 .env 并填入你的真实 API Key
# 
# 注意：.env 文件包含敏感信息，不要提交到版本控制系统

# ============================================
# 统一配置格式（推荐使用）
# ============================================
API_KEY=your_api_key_here
MODEL=glm-4-flash
PROVIDER=zhipu

# ============================================
# 各提供商配置示例（选择其中一个）
# ============================================

# 智谱AI (ZhipuAI)
# 获取 API Key: https://open.bigmodel.cn/
# API_KEY=sk-your_zhipu_key_here
# MODEL=glm-4-flash
# PROVIDER=zhipu
# 可选模型: glm-3-turbo, glm-4, glm-4-flash, glm-4-plus

# OpenAI
# 获取 API Key: https://platform.openai.com/
# API_KEY=sk-your_openai_key_here
# MODEL=gpt-4
# PROVIDER=openai
# 可选模型: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini

# Anthropic (Claude)
# 获取 API Key: https://www.anthropic.com/
# API_KEY=sk-ant-your_anthropic_key_here
# MODEL=claude-3-5-sonnet-20241022
# PROVIDER=anthropic
# 可选模型: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# 通义千问 (Qwen)
# 获取 API Key: https://dashscope.aliyun.com/
# API_KEY=sk-your_qwen_key_here
# MODEL=qwen-max
# PROVIDER=qwen
# 可选模型: qwen-turbo, qwen-plus, qwen-max, qwen-max-longcontext

# Google Gemini
# 获取 API Key: https://ai.google.dev/
# API_KEY=your_gemini_key_here
# MODEL=gemini-1.5-pro
# PROVIDER=gemini
# 可选模型: gemini-pro, gemini-pro-vision, gemini-1.5-pro, gemini-1.5-flash
